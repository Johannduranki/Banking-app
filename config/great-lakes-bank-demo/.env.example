# Great Lakes Bank presentation profile. Copy to a protected deployment env
# file and replace every secret before starting the stack.
NODE_ENV=development
APP_BANK_NAME=Great Lakes Bank
DEMO_MODE=true
PORT=3001
FRONTEND_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_BANK_NAME=Great Lakes Bank
NEXT_PUBLIC_DEMO_MODE=true

CORE_BANKING_PROVIDER=mock
FACE_PROVIDER=mock
LIVENESS_PROVIDER=mock
FINGERPRINT_PROVIDER=mock
SMS_PROVIDER=mock
OTP_PROVIDER=mock
OBJECT_STORAGE_PROVIDER=local

DB_HOST=localhost
DB_PORT=3306
DB_NAME=duranki_banking
DB_USER=duranki_app
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-random-secret
OTP_SECRET=replace-with-an-independent-32-character-random-secret
ADMIN_EMAIL=admin@greatlakesbank.test
ADMIN_PASSWORD=replace-with-a-strong-administrator-password
KYC_OFFICER_EMAIL=kyc.officer@greatlakesbank.test
KYC_OFFICER_PASSWORD=GreatLakesKyc!2026
OPERATIONS_USER_EMAIL=operations@greatlakesbank.test
OPERATIONS_USER_PASSWORD=GreatLakesOps!2026
KYC_MAKER_CHECKER_ENABLED=false
