NODE_ENV=development
APP_BANK_NAME=Great Lakes Bank
DEMO_MODE=false
PORT=3000
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=20
JSON_BODY_MAX_BYTES=262144
KYC_UPLOAD_MAX_BYTES=10485760
DB_HOST=localhost
DB_PORT=3306
DB_NAME=duranki_banking
DB_USER=duranki_app
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
OTP_SECRET=replace-with-an-independent-32-character-random-secret
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=mock
SMS_PROVIDER=mock
CORE_BANKING_PROVIDER=mock
# Production integration placeholders. Values and connection mode must come
# from Great Lakes Bank's approved FLEXCUBE specification and secret store.
FLEXCUBE_BASE_URL=
FLEXCUBE_USERNAME=
FLEXCUBE_PASSWORD=
FLEXCUBE_BRANCH=
FLEXCUBE_SOURCE=
FLEXCUBE_TIMEOUT=15000
FLEXCUBE_CONNECTION_MODE=NOT_CONFIGURED
FACE_PROVIDER=mock
LIVENESS_PROVIDER=mock
FINGERPRINT_PROVIDER=mock
KYC_MAKER_CHECKER_ENABLED=true
PRESENTATION_CUSTOMER_EMAIL=aline.niyonkuru@glb.local
PRESENTATION_CUSTOMER_PASSWORD=replace-with-a-development-only-password
ACTIVATION_TTL_MINUTES=15
TRANSFER_MAX_AMOUNT_MINOR=100000000
TRANSFER_DAILY_LIMIT_MINOR=250000000
TRANSFER_STEP_UP_THRESHOLD_MINOR=5000000
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-strong-administrator-password
KYC_OFFICER_EMAIL=kyc.officer@greatlakesbank.test
KYC_OFFICER_PASSWORD=replace-with-a-development-only-password
OPERATIONS_USER_EMAIL=operations@greatlakesbank.test
OPERATIONS_USER_PASSWORD=replace-with-a-development-only-password
FRONTEND_ORIGIN=http://localhost:3002
